<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only 127.0.0.1 (status mod inside the game); no connections to the outside. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- only used to reopen the deck from the background after Android ended it for memory (DeckAlarm) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <package android:name="com.droiddeck.launcher" />
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:appCategory="game" android:usesCleartextTraffic="true" android:theme="@style/Theme.P5r">
        <!-- Starter: the game in DroidDeck on top (display 0), the deck below (display 4) -->
        <activity android:name=".StarterActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FocusTopActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="de.harmssi.thorp5r.focus" />
        <activity android:name=".CompanionActivity" android:exported="true"
            android:label="@string/companion_name" android:launchMode="singleTask"
            android:resizeableActivity="true" android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode" />
        <receiver android:name=".DeckAlarm" android:exported="false" />
    </application>
</manifest>
